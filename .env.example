# ---------------------------------------------------------------------------
# Evenbooks environment. Copy to .env (root) for local development. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Application role (evenbooks_app). Used by web and worker at runtime.
DATABASE_URL=postgres://evenbooks_app:evenbooks_app@localhost:5432/evenbooks
# Owner role (evenbooks_owner). Used for migrations only.
DATABASE_OWNER_URL=postgres://evenbooks_owner:evenbooks_owner@localhost:5432/evenbooks
# Superuser. Used by `pnpm db:reset` / bootstrap and tests only. Not needed in production runtime.
DATABASE_ADMIN_URL=postgres://theo:theo@localhost:5432/postgres
EVENBOOKS_DB_NAME=evenbooks
EVENBOOKS_OWNER_PASSWORD=evenbooks_owner
EVENBOOKS_APP_PASSWORD=evenbooks_app
# Tests create throwaway databases through this superuser connection.
TEST_DATABASE_ADMIN_URL=postgres://theo:theo@localhost:5432/postgres

# --- Auth -----------------------------------------------------------------
# clerk | dev. Defaults to clerk when NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is set, else dev.
# dev mode is refused in production.
AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
DEV_SESSION_SECRET=change-me-for-shared-dev-environments

# --- Application ----------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
# Extra hostnames/IPs allowed to load the Next dev server's scripts (the machine hostname is always allowed)
DEV_ALLOWED_ORIGINS=
# 32 random bytes, base64. Encrypts SimpleFIN access URLs at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
LOG_LEVEL=debug
# development | production. Controls safety guards (dev auth refused in production).
APP_ENV=development

# --- Object storage (Railway bucket / any S3-compatible). Leave empty for local disk storage.
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./.data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email (SES). EMAIL_DRIVER=log writes emails to the log/outbox table instead of sending.
EMAIL_DRIVER=log                # log | ses
SES_REGION=us-east-1
SES_FROM_ADDRESS=
SES_REPLY_TO=
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required on web and worker for SES delivery callbacks; unset webhook fails closed.
# Copy the SNS topic ARN (not subscription ARN); see ops/email/sns-topic.md.
SES_SNS_TOPIC_ARN=
# Local development only: skip SNS signature verification (never in production)
SNS_SKIP_SIGNATURE_VERIFICATION=0

# --- SimpleFIN. SIMPLEFIN_DRIVER=fixture serves recorded responses for local development.
SIMPLEFIN_DRIVER=fixture        # fixture | live
SIMPLEFIN_ALLOWED_HOSTS=beta-bridge.simplefin.org,bridge.simplefin.org

# --- Online payments (Stripe Connect). PAYMENTS_DRIVER=fixture simulates Stripe locally (refused in production).
PAYMENTS_DRIVER=fixture         # fixture | stripe | off (off = no online payments; the only non-Stripe value allowed in production)
# Platform account secret key (sk_test_… / sk_live_…) and the Connect webhook endpoint secret for /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect OAuth: link existing Stripe accounts (ca_…); full sk_ key for the code exchange if STRIPE_SECRET_KEY is restricted
STRIPE_CONNECT_CLIENT_ID=
STRIPE_OAUTH_SECRET_KEY=
# Free-plan companies pay one all-in rate per online payment, Stripe's fee included; Evenbooks' application fee is the
# remainder after Stripe's published schedule (below). Paid-plan companies pay Stripe's fee only.
PLATFORM_FEE_CARD_PERCENT=5
PLATFORM_FEE_ACH_PERCENT=1
PROCESSOR_CARD_FEE_PERCENT=2.9
PROCESSOR_CARD_FEE_FIXED=0.30
PROCESSOR_ACH_FEE_PERCENT=0.8
PROCESSOR_ACH_FEE_CAP=5
# Clerk Billing organization plan slugs that count as the paid tier (comma separated). Without Billing, a custom
# session claim `org_plan` = {{org.public_metadata.plan}} set to "paid" works too.
CLERK_PAID_PLAN_SLUGS=paid,pro
# Members per company by tier; pushed to the Clerk organization's membership limit (Clerk caps at 20 without the B2B add-on)
CLERK_FREE_PLAN_MEMBERS=1
CLERK_PAID_PLAN_MEMBERS=20

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=4
# One-shot (cron) mode only: stop draining after this many ms so the next 5-minute tick is not skipped.
# WORKER_RUN_BUDGET_MS=240000
