{
  "name": "@evenbooks/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap-roles.ts",
    "reset": "tsx scripts/reset.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@evenbooks/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "@evenbooks/services": "workspace:*",
    "@evenbooks/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
